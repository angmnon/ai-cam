# =============================================================================
# AI CNC CAM API — 环境变量模板（复制为 .env 并按需填写）
# 复制：cp .env.example .env
# 注意：生产环境务必替换所有密钥；JWT_SECRET 缺失时 NODE_ENV=production 将拒绝启动。
# =============================================================================

# ---- Server ----
PORT=8080
HOST=0.0.0.0
# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---- P0-01 PostgreSQL 持久层 ----
# 留空则降级为进程内内存 store（仅开发/测试，启动打 WARN）；生产必须配置。
# 与 docker-compose.yml 对齐：postgres:16-alpine，5432，aicam/aicam_dev/aicam
# DATABASE_URL=postgres://aicam:aicam_dev@localhost:5432/aicam
# 连接池大小（可选，默认 10）
# PG_POOL_MAX=10

# ---- Auth（JWT）----
# 生产必须显式配置 JWT_SECRET；缺失且 NODE_ENV=production 直接拒绝启动。
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=ai-cam-api
JWT_EXPIRES_IN=24h

# ---- P0-03 多用户认证 / bootstrap 管理员（PG 模式首启播种 users+memberships）----
# 首次启动若 users 表为空，按 ADMIN_EMAIL/ADMIN_PASSWORD 创建 bootstrap ADMIN。
# v1 不开放公开注册：后续用户由该管理端创建。
ADMIN_EMAIL=admin@ai-cam.local
ADMIN_PASSWORD=changeme-admin
# ADMIN_ORG=org_admin

# ---- CORS 白名单（逗号分隔；非白名单 Origin 不回 ACAO）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 请求体上限（字节；默认 64MB）----
BODY_LIMIT_BYTES=67108864

# ---- Storage 适配器：local | r2 ----
STORAGE_DRIVER=local
STORAGE_DATA_DIR=./data
# R2（配置后切换 STORAGE_DRIVER=r2）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# R2_ENDPOINT=

# ---- Phase 0 单账号 bootstrap（仅当未配置 DATABASE_URL 的内存降级路径使用）----
# CAM_BOOTSTRAP_EMAIL=demo@ai-cam.local
# CAM_BOOTSTRAP_ORG=org_demo
# CAM_BOOTSTRAP_PASSWORD=demo
# CAM_BOOTSTRAP_PASSWORD_HASH=salt$hashHex   # scrypt(salt$hex)，配置后优先于明文

# ---- MODEL_PROVIDER_*（任一真实 LLM key 存在即 live，否则全程 MockProvider）----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_API_KEY=

# ---- P0-01 PostgreSQL 持久层 ----
# 生产（2026-10-03 决策）：Neon PostgreSQL，pooled 主机 + Hyperdrive
#   ⚠️ 真实连接串含密码，只写入 .gitignore 已忽略的 .env，
#      切勿写进本文件（本文件随仓库提交）。
# DATABASE_URL=postgresql://<user>:<pass>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Cloudflare / 对象存储 / 异步 ----
# Workers binding 由 wrangler.toml 注入，Worker 运行时不需要这些（R2/KV/Queues 走 binding）
# 仅本地开发（Fastify on Node）需要 R2 S3 兼容手动配置：
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# STORAGE_DRIVER=r2      # 生产走 binding + presigned PUT 直传，不走环境变量

# ---- 外部算力（腾讯云，仅 OCCT geometry-worker）----
# cam-kernel / stock-sim / post-core / nc-validator / feature-engine 都是 TS 纯计算，跑 Workers；
# 只有 geometry-worker 是 OCCT C++ 二进制，必须跑腾讯云 VM。
GEOMETRY_WORKER_URL=http://<tencent-vm>:<port>
GEOMETRY_WORKER_TOKEN=

# ---- 2D/3D 外部服务：MCP Gateway（gw.mcphubs.app）----
# 决策：2D 转换与 3D 特征识别全部由网关承载，本地不自建引擎。
# GATEWAY_BASE_URL=https://gw.mcphubs.app
# 租户令牌仅在服务端持有，绝不下发浏览器；调用走 POST /v1/invoke/<serviceId>
# GATEWAY_TENANT_JWT=

# ---- Observability ----
# auditSink: memory | file | pg        ← 生产用 pg（写 Neon）
AUDIT_SINK=pg
# metrics 端点鉴权令牌（/metrics，Prometheus 抓取用）
METRICS_TOKEN=
# OTLP_ENDPOINT=http://localhost:4318   # 配置后启用 OTel 导出（默认 noop）
# 注：Worker 运行时 Prometheus /metrics 不可用，改用 Workers Analytics Engine / Logs push
