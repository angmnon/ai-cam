# ---- Server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# ---- Auth（Phase 0 演示密钥，生产必须替换为密钥管理） ----
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=ai-cam-api
JWT_EXPIRES_IN=24h

# ---- Storage 适配器：local | r2 ----
STORAGE_DRIVER=local
DATA_DIR=./data
# R2（配置后切换 STORAGE_DRIVER=r2）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# ---- Observability ----
# OTLP_ENDPOINT=http://localhost:4318   # 配置后启用 OTel 导出（默认 noop）
