{
  "name": "@ai-cam/api",
  "version": "0.1.0",
  "description": "API 服务骨架（Fastify 5）：auth/租户/文件上传会话/Job 状态机/SSE 事件/OpenAPI/可观测性",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ai-cam/cam-ir": "workspace:*",
    "@ai-cam/cam-kernel": "workspace:*",
    "@ai-cam/dfm": "workspace:*",
    "@ai-cam/domain-schemas": "workspace:*",
    "@ai-cam/error-codes": "workspace:*",
    "@ai-cam/event-schema": "workspace:*",
    "@ai-cam/feature-engine": "workspace:*",
    "@ai-cam/geometry-schema": "workspace:*",
    "@ai-cam/job-schema": "workspace:*",
    "@ai-cam/master-data": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@opentelemetry/api": "^1.9.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
