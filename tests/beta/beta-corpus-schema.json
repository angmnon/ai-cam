{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beta 封闭测试 AI Proposal + Human Correction 记录",
  "type": "object",
  "required": ["schema_version", "record_id", "captured_at", "ai_proposal"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_id": { "type": "string", "pattern": "^beta_\\d{8}_\\d{4}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string" },
    "part": {
      "type": "object",
      "required": ["file", "bbox_mm"],
      "properties": {
        "file": { "type": "string" },
        "bbox_mm": { "type": "object" },
        "volume_mm3": { "type": "number" }
      }
    },
    "ai_proposal": {
      "type": "object",
      "required": ["operations", "setups", "sim_status"],
      "properties": {
        "features": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array" },
        "setups": { "type": "integer" },
        "sim_status": { "enum": ["PASS", "WARN", "FAIL"] },
        "nc_lines": { "type": "integer" }
      }
    },
    "human_correction": {
      "type": ["object", "null"],
      "properties": {
        "changed_ops": { "type": "array" },
        "reason": { "type": "string" },
        "accepted_ops": { "type": "array", "items": { "type": "string" } },
        "final_nc_lines": { "type": "integer" }
      }
    },
    "labels": { "type": "object" }
  }
}
